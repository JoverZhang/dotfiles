#!/usr/bin/env bash

# Link upstream (mattpocock/skills) skill directories into ~/.claude/skills/
# as symlinks pointing into the chezmoi source. Custom skills managed by chezmoi
# coexist as regular directories alongside these symlinks.

set -euo pipefail

UPSTREAM="{{ .chezmoi.sourceDir }}/dot_claude/skills-upstream"
SKILLS="{{ .chezmoi.homeDir }}/.claude/skills"

log() { printf "%s\n" "$*"; }

mkdir -p "$SKILLS"

# --- Cleanup: remove stale symlinks that point into the upstream dir ----------
for link in "$SKILLS"/*/; do
  link="${link%/}"
  [[ -L "$link" ]] || continue
  target="$(readlink "$link")"
  if [[ "$target" == "$UPSTREAM"/* ]]; then
    rm "$link"
  fi
done

# --- Link: create symlinks for each upstream skill ---------------------------
has_error=0
for skill_dir in "$UPSTREAM"/*/; do
  [[ -f "${skill_dir}SKILL.md" ]] || continue

  name="$(basename "$skill_dir")"

  # Collision check: if a non-symlink entry exists, it's a custom skill conflict
  if [[ -e "$SKILLS/$name" && ! -L "$SKILLS/$name" ]]; then
    log "ERROR: custom skill '$name' collides with upstream skill"
    has_error=1
    continue
  fi

  ln -sfn "$UPSTREAM/$name" "$SKILLS/$name"
done

if [[ "$has_error" -eq 1 ]]; then
  log "ERROR: one or more skill name collisions detected (see above)"
  exit 1
fi

log "Upstream skills linked into $SKILLS"
