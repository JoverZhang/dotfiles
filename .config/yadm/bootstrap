#!/usr/bin/env bash

# Restore recorded framework versions. Plugins are managed by Antidote and TPM.
set -eo pipefail

die() { printf 'bootstrap: %s\n' "$*" >&2; exit 1; }
target=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd -P)

components=${DOTFILES_COMPONENTS:-}
if [[ -z "$components" ]] && command -v yadm >/dev/null 2>&1 &&
   [[ $(yadm rev-parse --show-toplevel 2>/dev/null) == "$target" ]]; then
  components=$(yadm config local.components 2>/dev/null || true)
fi
read -r -a selected <<< "${components:-all}"
for component in "${selected[@]}"; do
  case "$component" in
    all|submodules|zsh|tmux|gdb) ;;
    *) die "unknown component: $component" ;;
  esac
done
selected_component() {
  local component
  for component in "${selected[@]}"; do
    [[ "$component" == all || "$component" == "$1" ]] && return 0
  done
  return 1
}
printf 'Selected components: %s\n' "${selected[*]}"

modules=()
if selected_component zsh; then
  command -v zsh >/dev/null 2>&1 || die 'install zsh with your package manager'
  command -v fzf >/dev/null 2>&1 && fzf --zsh >/dev/null 2>&1 ||
    die 'install fzf 0.48.0 or newer with your package manager'
  modules+=(omz antidote)
fi
if selected_component tmux; then
  command -v tmux >/dev/null 2>&1 || die 'install tmux with your package manager'
  modules+=(oh-my-tmux tpm)
fi
if selected_component submodules; then
  "$target/.local/bin/dotfiles-submodules" sync --all
elif (( ${#modules[@]} > 0 )); then
  "$target/.local/bin/dotfiles-submodules" sync "${modules[@]}"
fi

# Preserve the existing optional Linux GDB-dashboard installation.
if selected_component gdb && [[ $(uname -s) == Linux ]]; then
  dashboard="$target/.config/gdb/gdb-dashboard"
  if [[ -e "$dashboard/.git" ]]; then
    git -C "$dashboard" pull --ff-only
  elif [[ -e "$dashboard" || -L "$dashboard" ]]; then
    die "existing path is not a Git checkout: $dashboard"
  else
    mkdir -p "$target/.config/gdb"
    git clone --depth=1 https://github.com/cyrus-and/gdb-dashboard.git "$dashboard"
  fi
fi

printf 'Bootstrap completed.\n'
if selected_component tmux; then
  printf 'In tmux, press <prefix> I to install missing plugins with TPM.\n'
fi
