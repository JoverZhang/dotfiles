#!/usr/bin/env bash

# Initialize tracked submodules and install or update external shell tooling.
# Dependency failures are reported at the end; submodule failures stop.

set -uo pipefail

log() {
  printf '%s\n' "$*"
}

declare -a failures=()

record_failure() {
  local label="$1"
  failures+=("$label")
  log "WARNING: $label failed"
}

run_optional() {
  local label="$1"
  shift

  if "$@"; then
    return 0
  fi

  record_failure "$label"
  return 0
}

clone_or_update() {
  local dir="$1"
  local repo="$2"
  local name
  name="$(basename "$dir")"

  if [[ -d "$dir" ]]; then
    if [[ ! -e "$dir/.git" ]] || ! git -C "$dir" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
      record_failure "$name (existing path is not a Git worktree)"
      return 0
    fi

    log "Updating $name"
    run_optional "$name update" git -C "$dir" pull --ff-only
    return 0
  fi

  if [[ -e "$dir" ]]; then
    record_failure "$name (existing path is not a directory)"
    return 0
  fi

  if ! mkdir -p "$(dirname "$dir")"; then
    record_failure "$name parent directory creation"
    return 0
  fi

  log "Cloning $name"
  run_optional "$name clone" git clone --depth=1 --single-branch "$repo" "$dir"
}

if ! command -v yadm >/dev/null 2>&1; then
  log "ERROR: yadm is required to locate the work tree"
  exit 1
fi

# yadm bootstrap does not forward CLI arguments; selection is local config.
# DOTFILES_COMPONENTS can override it for a single explicit bootstrap run.
components=${DOTFILES_COMPONENTS:-$(yadm config local.components 2>/dev/null || true)}
read -r -a selected <<< "${components:-all}"
for component in "${selected[@]}"; do
  case "$component" in
    all|submodules|zsh|tmux|gdb) ;;
    *) log "ERROR: unknown component: $component"; exit 1 ;;
  esac
done
selected_component() {
  local component
  for component in "${selected[@]}"; do
    [[ "$component" == all || "$component" == "$1" ]] && return 0
  done
  return 1
}

# Honor yadm's work tree, including an isolated restore made with clone -w.
target=$(yadm rev-parse --show-toplevel) || exit 1
cd "$target" || exit 1
log "Selected components: ${selected[*]}"

if selected_component submodules; then
  log "Synchronizing tracked submodules"
  yadm submodule sync --recursive || exit 1
  log "Initializing tracked submodules"
  yadm submodule update --init --recursive || exit 1
fi

declare -a repos=()
if selected_component zsh; then
  repos+=(
    "$target/.config/zsh/ohmyzsh|https://github.com/ohmyzsh/ohmyzsh.git"
    "$target/.config/zsh/zsh-autosuggestions|https://github.com/zsh-users/zsh-autosuggestions.git"
    "$target/.config/zsh/zsh-syntax-highlighting|https://github.com/zsh-users/zsh-syntax-highlighting.git"
    "$target/.config/zsh/fzf-tab|https://github.com/Aloxaf/fzf-tab.git"
  )
  # Modern fzf ships its shell integration in the installed binary. Older
  # installations continue to use the tracked bootstrap's script checkout.
  if command -v fzf >/dev/null 2>&1; then
    if ! fzf --zsh >/dev/null 2>&1; then
      repos+=("$target/.config/zsh/fzf|https://github.com/junegunn/fzf.git")
    fi
  else
    record_failure "fzf is missing; install it with your system package manager"
  fi
fi
if selected_component tmux; then
  repos+=(
    "$target/.config/tmux/oh-my-tmux|https://github.com/gpakosz/.tmux.git"
    "$target/.config/tmux/plugins/tpm|https://github.com/tmux-plugins/tpm.git"
  )
fi
if selected_component gdb && [[ "$(uname -s)" == Linux ]]; then
  repos+=("$target/.config/gdb/gdb-dashboard|https://github.com/cyrus-and/gdb-dashboard.git")
fi

for item in "${repos[@]}"; do
  IFS='|' read -r dir repo <<<"$item"
  clone_or_update "$dir" "$repo"
done

tpm="$target/.config/tmux/plugins/tpm"
if selected_component tmux && [[ -d "$tpm/.git" ]]; then
  # TPM otherwise guesses ~/.tmux/plugins when no server has set its path.
  export TMUX_PLUGIN_MANAGER_PATH="$target/.config/tmux/plugins/"
  if [[ -x "$tpm/bin/install_plugins" ]]; then
    log "Running TPM install_plugins"
    run_optional "TPM install_plugins" "$tpm/bin/install_plugins"
  else
    record_failure "TPM install_plugins (script is missing or not executable)"
  fi

  if [[ -x "$tpm/bin/update_plugins" ]]; then
    log "Running TPM update_plugins all"
    run_optional "TPM update_plugins" "$tpm/bin/update_plugins" all
  else
    record_failure "TPM update_plugins (script is missing or not executable)"
  fi
elif selected_component tmux; then
  record_failure "TPM repository is unavailable"
fi

if (( ${#failures[@]} > 0 )); then
  log "Bootstrap completed with ${#failures[@]} dependency failure(s):"
  printf '  - %s\n' "${failures[@]}"
  exit 1
else
  log "Bootstrap completed successfully"
fi

exit 0
