# mira account paths and runtime setup. Shared behavior lives in zshrc.sh.
[[ -r "$HOME/.local/bin/env" ]] && source "$HOME/.local/bin/env"
export BUN_INSTALL="$HOME/.bun"
typeset -U path PATH
path=("$BUN_INSTALL/bin" "$HOME/lab/workflow/bin" "$HOME/lab/bin" "$HOME/.local/bin" $path)
export NVM_DIR="$HOME/.nvm"
[[ -s "$NVM_DIR/nvm.sh" ]] && source "$NVM_DIR/nvm.sh"
[[ -s "$NVM_DIR/bash_completion" ]] && source "$NVM_DIR/bash_completion"
export EDITOR=nvim
alias cdr='grt'
alias edit-zsh='${EDITOR:-vim} ~/.config/zsh/zshrc.sh'
alias reload-zsh='exec zsh'
alias omz-update='omz update'
alias omz-reload='omz reload'
alias maka-dev='node "$HOME/lab/projects/maka/packages/cli/dist/dev-cli.js"'
